# ---------------------------------------------------------------------------
# Firebase (obrigatório) — Console > Configurações do projeto > Seus apps > Web
# Sem estas variáveis o app abre, mas o login e a persistência ficam desligados.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Firebase Local Emulator Suite (opcional) — para rodar/testar sem depender
# de um projeto Firebase real. Com "true", o app conecta em Auth/Firestore
# locais (`firebase emulators:start --only auth,firestore`, portas 9099 e
# 8080) em vez do projeto de VITE_FIREBASE_PROJECT_ID. As variáveis
# VITE_FIREBASE_* acima ainda precisam estar preenchidas (podem ser valores
# fictícios, tipo "demo-project"), só não são realmente usadas.
# ---------------------------------------------------------------------------
VITE_USE_FIREBASE_EMULATOR=false

# ---------------------------------------------------------------------------
# SMTP (opcional) — usado apenas pelo endpoint /api/send-email, que dispara os
# alertas de permuta/substituição/exceção (ver src/lib/emailService.ts).
# Sem estas variáveis o envio é apenas simulado (log no servidor).
# A recuperação de senha NÃO usa SMTP: é feita pelo Firebase Authentication.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu_email_da_secao@gmail.com
SMTP_PASS=sua_senha_de_aplicativo_do_google
SMTP_FROM=Sistema CBMPA <seu_email_da_secao@gmail.com>

# ---------------------------------------------------------------------------
# Notificações push no navegador (opcional) — ver src/lib/pushNotifications.ts
# e /api/send-push em server.ts. Sem estas duas variáveis o botão "Ativar
# notificações push" em Meu Perfil nem aparece; alerta interno + e-mail
# continuam funcionando normalmente de qualquer jeito.
#
# VITE_FIREBASE_VAPID_KEY: Firebase Console > Configurações do projeto >
# Cloud Messaging > aba "Web configuration" > "Generate key pair" (ou "Par
# de chaves"). É pública (vai no bundle do front), só identifica o app.
#
# FIREBASE_SERVICE_ACCOUNT_JSON: Firebase Console > Configurações do
# projeto > Contas de serviço > "Gerar nova chave privada" — baixa um
# arquivo .json. Cole o CONTEÚDO INTEIRO dele aqui, numa linha só. Essa
# chave é secreta (dá acesso administrativo ao projeto Firebase inteiro) —
# nunca versionar, nunca compartilhar, só no .env do servidor.
# ---------------------------------------------------------------------------
VITE_FIREBASE_VAPID_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
